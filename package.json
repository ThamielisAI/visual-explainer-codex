{
  "name": "visual-explainer-extension",
  "version": "1.1.0",
  "description": "Agent skill that generates beautiful HTML pages for diagrams, diff reviews, plan reviews, and data tables with native AI image generation.",
  "author": "ThamielisAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThamielisAI/visual-explainer-codex.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:typescript && npm run build:mcp",
    "build:typescript": "tsx scripts/embed-assets.ts && tsc",
    "build:mcp": "esbuild dist/index.js --bundle --platform=node --format=cjs --outfile=mcp/server.cjs --log-level=warning",
    "watch": "tsc --watch",
    "test": "vitest run"
  },
  "keywords": [
    "pi-package",
    "gemini-extension",
    "codex-plugin"
  ],
  "license": "MIT",
  "pi": {
    "skills": [
      "./skills/visual-explainer"
    ],
    "prompts": [
      "./commands"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  }
}
